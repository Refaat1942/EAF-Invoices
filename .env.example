# منفذ البرنامج — اختر أي رقم فاضي (80 أو 8080 أو 3000 أو 17159...)
# الرابط النهائي = http://IP-الثابت:PORT
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgresql://eaf:CHANGE_ME@localhost:5432/eaf_invoices

# Production (NODE_ENV=production) — required; use openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
ALLOWED_ORIGINS=http://192.168.1.10:8080,http://localhost:8080
APP_SECRET=REPLACE_WITH_RANDOM_STRING

# First setup only (12+ chars) when no users exist — creates admin once
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Optional backup configuration
BACKUP_DIR=/var/backups/eaf-invoices
BACKUP_RETENTION_DAYS=14

# HTTPS / reverse proxy
# COOKIE_SECURE=true
# TRUST_PROXY=true
# HTTPS=true
