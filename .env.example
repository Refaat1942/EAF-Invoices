# منفذ البرنامج — اختر أي رقم فاضي (80 أو 8080 أو 3000 أو 17159...)
# الرابط النهائي = http://IP-الثابت:PORT
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgresql://eaf:CHANGE_ME@localhost:5432/eaf_invoices

# Production (NODE_ENV=production) — required; use openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
# Must include every URL users open in the browser (IP, domain, port)
ALLOWED_ORIGINS=http://192.168.1.10:17159,http://localhost:17159
PUBLIC_APP_URL=http://192.168.1.10:17159
# Use quotes when the password contains # or other special characters
ADMIN_PASSWORD="ChangeMe-Admin-2026!"
APP_SECRET=REPLACE_WITH_RANDOM_STRING

# First setup only (12+ chars) when no users exist — creates admin once
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Optional backup configuration
BACKUP_DIR=/var/backups/eaf-invoices
BACKUP_RETENTION_DAYS=14

# HTTPS / reverse proxy
# COOKIE_SECURE=true
# TRUST_PROXY=true
# HTTPS=true

# Daily charge screens (medicines, supplies, exams, lab, radiology, sessions, other, stay...)
# read items/prices from the default price list (Settings → إدارة الأسعار) by default and
# only fall back to a section's uploaded per-tab catalog when the price list has nothing
# configured for it. Set to false to restore the old catalog-first behavior.
# DAILY_CHARGES_PRICE_LIST_ONLY=true
